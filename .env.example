# Copy this file to .env and replace every blank value.
# .env is gitignored. These values are local development secrets, not application defaults.
# Passwords must be 16-128 characters from [A-Za-z0-9_-].

POSTGRES_USER=synapse
POSTGRES_PASSWORD=
POSTGRES_DB=synapse
SYNAPSE_APP_PASSWORD=

# Host-side URLs for pytest, Alembic, and uvicorn on the developer machine.
# Substitute the same passwords used above. The Compose API container overrides
# the host name to the postgres service.
MIGRATION_DATABASE_URL=postgresql+psycopg://synapse:REPLACE_POSTGRES_PASSWORD@localhost:5432/synapse
DATABASE_URL=postgresql+psycopg://synapse_app:REPLACE_APP_PASSWORD@localhost:5432/synapse

SYNAPSE_ENVIRONMENT=local
SYNAPSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# One-line JSON. Tokens must be at least 16 characters (32 when SYNAPSE_ENVIRONMENT=production).
# SYNAPSE_AUTH_TOKENS={"replace-with-admin-token-32chars":{"actor":"local-admin","role":"admin"},"replace-with-viewer-token-32ch":{"actor":"local-viewer","role":"viewer"}}
SYNAPSE_AUTH_TOKENS=
