{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse-crs.local/schemas/target-scope-1.0.0.schema.json",
  "title": "TargetScope",
  "type": "object",
  "additionalProperties": false,
  "x-synapse-contract-version": "1.0.0",
  "required": ["environment", "assets", "description"],
  "properties": {
    "environment": {
      "type": "string",
      "enum": ["lab", "development"]
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
