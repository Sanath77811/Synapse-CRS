{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse-crs.local/schemas/telemetry-envelope-1.0.0.schema.json",
  "title": "TelemetryEnvelope",
  "description": "Phase 1 telemetry contract 1.0.0. Untrusted observations only. procfs polling, signing, and ingestion are not implemented. observed_at uses the audit timestamp form. The pattern does not exclude every impossible civil date; the Python model rejects those.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 11,
  "x-synapse-contract-version": "1.0.0",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "target_id",
    "agent_id",
    "boot_id",
    "sequence",
    "observed_at",
    "basis",
    "content_class",
    "payload"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0", "minLength": 5, "maxLength": 5},
    "event_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_type": {
      "type": "string",
      "minLength": 14,
      "maxLength": 27,
      "enum": ["process_started", "process_exited", "network_connection_observed"]
    },
    "target_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "agent_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "boot_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "observed_at": {
      "type": "string",
      "minLength": 27,
      "maxLength": 27,
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"
    },
    "basis": {"type": "string", "const": "procfs_poll", "minLength": 11, "maxLength": 11},
    "content_class": {"type": "string", "const": "observation", "minLength": 11, "maxLength": 11},
    "payload": {"type": "object", "maxProperties": 6}
  },
  "allOf": [
    {
      "if": {
        "properties": {"event_type": {"const": "process_started"}},
        "required": ["event_type"]
      },
      "then": {
        "properties": {"payload": {"$ref": "telemetry-process-started-1.0.0.schema.json"}}
      }
    },
    {
      "if": {
        "properties": {"event_type": {"const": "process_exited"}},
        "required": ["event_type"]
      },
      "then": {
        "properties": {"payload": {"$ref": "telemetry-process-exited-1.0.0.schema.json"}}
      }
    },
    {
      "if": {
        "properties": {"event_type": {"const": "network_connection_observed"}},
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": {"$ref": "telemetry-network-connection-observed-1.0.0.schema.json"}
        }
      }
    }
  ]
}
