{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse-crs.local/schemas/telemetry-network-connection-observed-1.0.0.schema.json",
  "title": "NetworkConnectionObservedPayload",
  "description": "A network endpoint observed from procfs tables. remote_address is only the redaction token [ip]. Raw addresses and payload bytes are not representable.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 6,
  "x-synapse-contract-version": "1.0.0",
  "required": ["protocol", "local_port", "remote_port", "remote_address", "uid", "pid"],
  "properties": {
    "protocol": {"type": "string", "enum": ["tcp", "tcp6", "udp", "udp6"]},
    "local_port": {"type": "integer", "minimum": 0, "maximum": 65535},
    "remote_port": {"type": "integer", "minimum": 0, "maximum": 65535},
    "remote_address": {"type": "string", "const": "[ip]", "minLength": 4, "maxLength": 4},
    "uid": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "pid": {
      "anyOf": [
        {"type": "integer", "minimum": 1, "maximum": 4194304},
        {"type": "null"}
      ]
    }
  }
}
