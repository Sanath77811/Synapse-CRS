{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse-crs.local/schemas/telemetry-process-exited-1.0.0.schema.json",
  "title": "ProcessExitedPayload",
  "description": "A previously observed pid and start_ticks pair was absent on a later procfs poll. This is not a kernel exit record and has no exit code.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 2,
  "x-synapse-contract-version": "1.0.0",
  "required": ["pid", "start_ticks"],
  "properties": {
    "pid": {"type": "integer", "minimum": 1, "maximum": 4194304},
    "start_ticks": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
  }
}
