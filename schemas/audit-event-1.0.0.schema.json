{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse-crs.local/schemas/audit-event-1.0.0.schema.json",
  "title": "AuditEvent",
  "type": "object",
  "additionalProperties": false,
  "x-synapse-contract-version": "1.0.0",
  "required": [
    "id",
    "sequence",
    "timestamp",
    "actor",
    "event_type",
    "target_id",
    "case_id",
    "payload",
    "previous_event_hash",
    "event_hash",
    "contract_version"
  ],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "sequence": {"type": "integer", "minimum": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1, "maxLength": 200},
    "event_type": {"type": "string", "minLength": 1, "maxLength": 100},
    "target_id": {"type": ["string", "null"], "format": "uuid"},
    "case_id": {"type": ["string", "null"], "format": "uuid"},
    "payload": {"type": "object"},
    "previous_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_version": {"type": "string", "const": "1.0.0"}
  }
}
